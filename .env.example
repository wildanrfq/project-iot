# Port server backend & static UI (production)
PORT=3001

# Mode awal: "blynk" atau "simulator"
DATA_SOURCE=blynk

# Konfigurasi Blynk Cloud
BLYNK_SERVER=sgp1.blynk.cloud
BLYNK_AUTH_TOKEN=
POLL_INTERVAL_MS=2000

# Konfigurasi Bot Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COOLDOWN_SEC=60
TELEGRAM_NOTIFY_RECOVERY=true

